# Путь к папке с фотографиями (абсолютный или относительный)
# Примеры:
# Windows: PHOTOS_DIR=C:/Users/username/Pictures/Portfolio
# Linux/macOS: PHOTOS_DIR=/home/username/portfolio
PHOTOS_DIR=./images

# Качество сжатия WebP от 1 до 100 (по умолчанию 80 - оптимально для сайтов)
WEBP_QUALITY=80

# Искать фото во всех вложенных подпапках (true / false)
RECURSIVE=true

# Пропускать файлы, если файл .webp уже существует (true / false)
SKIP_EXISTING=true

# Удалять исходные JPG/JPEG после успешной конвертации (true / false)
# Внимание: используйте true только если уверены, что оригиналы больше не нужны!
REMOVE_ORIGINALS=false
